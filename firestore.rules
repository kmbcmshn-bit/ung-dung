rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master safety net: deny all unmatched by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection validation test
    match /test/{testId} {
      allow read, write: if true;
    }

    // Classrooms collection
    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    // Enrolled students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // Exams and test matrices
    match /exams/{examId} {
      allow read: if true;
      allow write: if isValidId(examId);
    }

    // Submissions and grading records
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if isValidId(submissionId);
    }

    // Grade complaints and appeals
    match /complaints/{complaintId} {
      allow read: if true;
      allow write: if isValidId(complaintId);
    }

    // Teacher profiles and configurations
    match /teacherProfiles/{profileId} {
      allow read: if true;
      allow write: if isValidId(profileId);
    }
  }
}
